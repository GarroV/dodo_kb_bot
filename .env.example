# Скопируй в .env и заполни. .env в git не попадает (см. .gitignore).

# Токен бота от @BotFather — отдельный бот под этот проект (не переиспользуй чужой).
BOT_TOKEN=

# Ключ OpenAI (разбор вопроса + вызов инструментов KB).
# Модель: gpt-5.6-luna. Замер на 4 живых вопросах: luna и gpt-5.6-terra дают
# конкретику из статей и честно говорят «по этой стране нет материалов», а
# gpt-4o-mini подсовывает нерелевантное и домысливает советы. Luna ~$0.009 за
# запрос против ~$0.073 у terra при сопоставимом качестве, поэтому по умолчанию
# она. Нужно максимальное качество — OPENAI_MODEL=gpt-5.6-terra.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Сервисный PAT от Базы Знаний (knowledgebase.dodois.io) — выдаёт админ БЗ.
# Единственный токен на весь бот, партнёры его не видят. Права read-only: без
# заголовка Mcp-Mode сервер не отдаёт write-инструменты вообще.
KB_MCP_URL=https://knowledgebase.dodois.io/mcp
KB_MCP_TOKEN=

# Твой Telegram ID (не username) — единственный, кому отвечает /stats (счётчик
# транзакций и токенов). Не задан — команда молчит всем. Узнать свой id: @userinfobot.
ADMIN_TELEGRAM_ID=
